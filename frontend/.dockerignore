# ==========================================
# 1. Ignore Heavy Dependencies & Build Outputs
# ==========================================
node_modules/
dist/
build/
.next/

# ==========================================
# 2. Ignore Local Environment Secrets
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# 3. Ignore Logs and Debug Files
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 4. Ignore IDEs and OS Junk
# ==========================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db